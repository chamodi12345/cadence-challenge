{
  "name": "cadence",
  "version": "0.1.0",
  "private": true,
  "description": "Cadence — multi-tenant commission and payout console (MADLABS dev intern challenge)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "tsx scripts/reset-db.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "verify": "npm run lint && npm run typecheck && npm test",
    "dev": "tsx watch src/server.ts",
    "seed": "tsx scripts/run-seed.ts",
    "onboard-company": "tsx scripts/create-company.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.21.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.1",
    "vitest": "^2.1.9"
  }
}
