# Copy to .env — .env is gitignored and must never be committed.

# Local development database (docker-compose.yml maps 5432 in the container to 5433 on the host)
DATABASE_URL=postgresql://cadence:cadence_local_dev@localhost:5433/cadence

# Application
NODE_ENV=development
PORT=4700
LOG_LEVEL=debug

# Auth — generate your own, do not reuse this placeholder:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-before-first-run
JWT_EXPIRES_IN=1h

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:4700/api/v1
